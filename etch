#!/bin/sh
#
# etch - A simple system fetch.

WHITE="\033[0;0m"
RED="\033[0;31m"
GREEN="\033[0;32m"
ORANGE="\033[0;33m"
BLUE="\033[0;34m"
PURPLE="\033[0;35m"
COW="\033[5;31m\033[3;31m"

clear
echo -e "
$COW \      (_,_)   $BLUE$USER$WHITE@$RED$HOSTNAME
$COW  '---_.(,o o)  $GREEN$(uname) $(uname -m)
$COW  |     .-('.') $ORANGE$(uname -r)
$COW .''w--:|       $BLUE$XDG_CURRENT_DESKTOP
$COW   '  .  '      $PURPLE$TERM

$WHITE" mem" $ORANGE$(free -h --giga | grep -Po "Mem:\s+\S+\s+\K\S+")$WHITE / $RED$(free -h --giga | grep -Po "Mem:\s+\K\S+")
$WHITE" pac" $GREEN$(pacman -Q | wc -l)$WHITE
"
