#!/bin/bash
#
# etch - A simple system fetch.

WHITE="\033[0;0m"
RED="\033[0;31m"
GREEN="\033[0;32m"
ORANGE="\033[0;33m"
BLUE="\033[0;34m"
PURPLE="\033[0;35m"
COW="\033[5;31m"

echo -e "
                $BLUE$USER$WHITE@$RED$HOSTNAME
$COW \      (_,_)   $GREEN$(uname) $(uname -m)
$COW  '---_.(,o o)  $ORANGE$(uname -r)
$COW  |     .-('.') $BLUE$XDG_CURRENT_DESKTOP
$COW .''w--:|       $PURPLE$TERM
$COW   '  .  '      $WHITE"mem:" $ORANGE$(free -h --giga | grep -Po "Mem:\s+\S+\s+\K\S+")$WHITE / $RED$(free -h --giga | grep -Po "Mem:\s+\K\S+")
                $WHITE"pac:" $GREEN$(dpkg --get-selections | grep -v deinstall | wc -l)$WHITE
"
